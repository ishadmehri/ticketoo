<?xml version="1.0"?>
<ruleset name="Ticketoo">
	<description>Coding standards for the Ticketoo plugin.</description>

	<file>ticketoo.php</file>
	<file>includes</file>
	<file>templates</file>
	<file>integrations</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/assets/js/*</exclude-pattern>

	<arg name="basepath" value="."/>
	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="text_domain" value="ticketoo"/>

	<rule ref="WordPress"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="ticketoo"/>
			</property>
		</properties>
	</rule>

	<!--
		Class files use PSR-4-style names (Autoloader.php, Plugin.php,
		Gutenberg.php, ...) as required by the spec and the plugin autoloader,
		so the WordPress core class-file naming rules do not apply to them.
	-->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>*/includes/*</exclude-pattern>
		<exclude-pattern>*/integrations/*</exclude-pattern>
	</rule>
</ruleset>
